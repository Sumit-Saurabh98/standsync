generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum AuthProvider {
  GOOGLE
  GITHUB
}
enum Role {
  OWNER
  ADMIN
  MEMBER
}
enum WebhookPlatform {
  SLACK
  DISCORD
  TEAMS
  GENERIC
}
enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum DigestStatus {
  GENERATED
  SENT
  FAILED
}

enum DeliveryStatus {
  PENDING
  SUCCESS
  FAILED
}

enum ExportFormat {
  CSV
  XLSX
  PDF
}

enum ExportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model AuthAccount{
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider AuthProvider
  providerAccountId String
  email String?
  createdAt DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("auth_accounts")
}

model RefreshToken{
  id String @id @default(cuid())
  userId String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId   String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_resets")
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String?
  name            String
  avatarUrl       String?
  isEmailVerified Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  authAccounts    AuthAccount[]
  refreshTokens   RefreshToken[]
  passwordResets  PasswordReset[]
  emailVerifications EmailVerification[]
  teamMemberships TeamMember[]
  standups        Standup[]
  exportJobs        ExportJob[]
  ownedTeams      Team[]       @relation("TeamOwner")
  invitations     Invitation[] @relation("InvitedBy")


  @@map("users")
}

model EmailVerification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("email_verifications")
}

model Team {
  id        String    @id @default(cuid())
  name      String
  ownerId   String
  owner     User      @relation("TeamOwner", fields: [ownerId], references: [id])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  members     TeamMember[]
  config      TeamConfig?
  invitations Invitation[]
  standups            Standup[]
  digests             Digest[]
  webhookDeliveries   WebhookDelivery[]
  dailyTeamStats      DailyTeamStat[]
  exportJobs          ExportJob[]

  @@index([ownerId])
  @@map("teams")
}
model TeamMember {
  id       String   @id @default(cuid())
  teamId   String
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     Role
  joinedAt DateTime @default(now())
  @@unique([teamId, userId])
  @@index([userId])
  @@map("team_members")
}
model TeamConfig {
  id              String          @id @default(cuid())
  teamId          String          @unique
  team            Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  timezone        String          @default("UTC")
  workingDays     Int[]           @default([1, 2, 3, 4, 5])
  standupDeadline String          @default("10:00")
  reminderTime    String          @default("09:00")
  webhookUrl      String?
  webhookPlatform WebhookPlatform @default(GENERIC)
  isActive        Boolean         @default(true)
  @@map("team_configs")
}
model Invitation {
  id        String       @id @default(cuid())
  teamId    String
  team      Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  email     String
  role      Role         @default(MEMBER)
  token     String       @unique
  status    InviteStatus @default(PENDING)
  invitedBy String
  inviter   User         @relation("InvitedBy", fields: [invitedBy], references: [id])
  expiresAt DateTime
  createdAt DateTime     @default(now())
  @@index([teamId, email])
  @@map("invitations")
}

model Standup {
  id          String    @id @default(cuid())
  teamId      String
  team        Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  standupDate DateTime  @db.Date
  yesterday   String
  today       String
  blockers    String?
  isLate      Boolean   @default(false)
  submittedAt DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([teamId, standupDate])
  @@index([userId, standupDate])
  @@map("standups")
}

model Digest {
  id          String       @id @default(cuid())
  teamId      String
  team        Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  digestDate  DateTime     @db.Date
  content     Json
  submitted   Int
  missing     Int
  lateCount   Int
  status      DigestStatus @default(GENERATED)
  generatedAt DateTime     @default(now())
  deliveries  WebhookDelivery[]

  @@unique([teamId, digestDate])
  @@index([teamId])
  @@map("digests")
}

model WebhookDelivery {
  id          String          @id @default(cuid())
  digestId    String?
  digest      Digest?         @relation(fields: [digestId], references: [id], onDelete: SetNull)
  teamId      String
  team        Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  platform    WebhookPlatform
  payload     Json?
  dedupeKey   String          @unique
  status      DeliveryStatus  @default(PENDING)
  attempts    Int             @default(0)
  lastError   String?
  deliveredAt DateTime?

  @@index([teamId, status])
  @@map("webhook_deliveries")
}

model DailyTeamStat {
  id             String   @id @default(cuid())
  teamId         String
  team           Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  statDate       DateTime @db.Date
  memberCount    Int
  submittedCount Int
  missingCount   Int
  lateCount      Int
  participation  Float
  createdAt      DateTime @default(now())

  @@unique([teamId, statDate])
  @@index([teamId, statDate])
  @@map("daily_team_stats")
}

model ExportJob {
  id          String       @id @default(cuid())
  teamId      String
  team        Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  format      ExportFormat
  status      ExportStatus @default(PENDING)
  filePath    String?
  fileName    String?
  lastError   String?
  createdAt   DateTime     @default(now())
  completedAt DateTime?

  @@index([teamId, status])
  @@map("export_jobs")
}

