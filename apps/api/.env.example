# Core
NODE_ENV=development
PORT=3000

# Database (PostgreSQL / Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/standsync?schema=public"

# Redis (BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

